# ─── Runtime ──────────────────────────────────────────────────────────────────
# Absolute origin of the deployed site. Drives canonical URLs, sitemap.xml,
# robots.txt and Open Graph tags. Must have no trailing slash.
KARKANA_SITE_URL=http://localhost:3000
# Signing key for session cookies. REQUIRED in production: the app refuses to
# boot without it. In development a random per-process key is generated.
KARKANA_SESSION_SECRET=

# Optional. Comma-separated origins allowed to fetch Next's dev-only resources
# (HMR, devtools fonts) when the dev server is reached through a tunnel or
# preview proxy. Wildcards allowed. Ignored in production builds.
KARKANA_ALLOWED_DEV_ORIGINS=

# ─── Admin operator ───────────────────────────────────────────────────────────
# Generate the hash with:  npx tsx scripts/hash-password.ts 'your password'
ADMIN_USERNAME=admin@karkana.com
ADMIN_PASSWORD_HASH=

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave unset in development to use the JSON adapter (data/karkana.db.json).
# Setting this switches the whole app to Postgres; it is REQUIRED in production.
DATABASE_URL=

# Override the JSON adapter's file. Used by `npm run smoke` so the smoke test
# writes to a scratch copy and never rewrites the committed catalogue.
KARKANA_DB_PATH=

# ─── Object storage (Cloudflare R2 / Backblaze B2 / any S3) ───────────────────
# Leave unset in development to write to public/uploads on the local disk.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
# Optional public CDN host in front of the bucket (used by next/image).
CDN_HOST=

# ─── Business policy (integer rupees) ─────────────────────────────────────────
# Both default to 0, preserving the v1 charging behaviour.
KARKANA_PERSONALIZATION_FEE=0
KARKANA_SHIPPING_FEE=0
